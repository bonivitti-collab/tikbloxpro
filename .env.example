# Copie para .env só no ambiente local. Na Vercel, cadastre os mesmos nomes em
# Project Settings → Environment Variables. Não commite o arquivo .env.

# Segredo que assina a sessão (mínimo 32 caracteres). Gere com:
# openssl rand -base64 48
# Não reutilize o valor antigo que já vazou no histórico do Git.
TIKBLOX_AUTH_SECRET=

# Login do dono. Use a senha que você já usa. Mínimo de 4 caracteres;
# o recomendado é 12 ou mais. Nada disso fica no código.
TIKBLOX_ADMIN_EMAIL=
TIKBLOX_ADMIN_PASSWORD=
TIKBLOX_ADMIN_NAME=

# Opcional. Sem esta chave, /api/tiktok-verify responde "verificação indisponível".
# RAPIDAPI_KEY=

# Token que a Kiwify gera no webhook (cerca de 11 caracteres; mínimo aceito: 8).
# A Kiwify assina o corpo com HMAC-SHA1 e manda o resultado em ?signature=
KIWIFY_WEBHOOK_TOKEN=

# Opcional. Se preenchido, só estes product_id da Kiwify liberam acesso
# (separados por vírgula). Vazio aceita qualquer produto do webhook assinado.
KIWIFY_PRODUCT_ID=

# Horas de acesso depois de subscription_late. 48 é o padrão.
# 0 revoga na hora. Durante a carência o login continua válido.
KIWIFY_LATE_GRACE_HOURS=48

# Supabase do projeto TikBlox (plano gratuito). Use a service role só no servidor.
# Nunca coloque estas chaves em variável VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional. Checkout público do Radar Essential. O padrão já é o link de R$ 37.
# VITE_KIWIFY_CHECKOUT_ESSENTIAL=https://pay.kiwify.com.br/B69SrmS

PORT=3000
