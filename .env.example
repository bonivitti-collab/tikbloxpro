# ==============================================================================
# CONFIGURAÇÃO DE APIS 100% GRATUITAS PERMANENTES - TIKBLOX
# ==============================================================================
#
# O TIKBLOX foi projetado para funcionar com CUSTO ZERO (R$ 0,00) PERMANENTEMENTE.
# Você pode escolher qualquer uma das opções gratuitas abaixo:
#
# OPÇÃO 1: Google Gemini Free Tier (Recomendado - Grátis para sempre)
# Crie sua chave gratuita sem precisar cadastrar cartão em: https://aistudio.google.com/app/apikey
# Limite gratuito generoso de 15 requisições/minuto no modelo gemini-2.5-flash.
GEMINI_API_KEY=

# OPÇÃO 2: Groq Cloud API (Alternativa 100% Gratuita e Ultrarrápida)
# Crie sua chave gratuita em: https://console.groq.com/keys
# Roda Llama 3.3 70B sem custo algum.
GROQ_API_KEY=

# OPÇÃO 3: NENHUMA CHAVE (Modo Autônomo Local)
# Se você deixar vazio, o TIKBLOX usa seu motor autônomo interno com zero dependências
# externas, 100% offline, perpétuo e sem gastar 1 centavo.

# URL da aplicação (injetada automaticamente pelo ambiente)
APP_URL=
